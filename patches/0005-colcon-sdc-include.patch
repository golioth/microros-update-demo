diff --git a/modules/libmicroros/libmicroros.mk b/modules/libmicroros/libmicroros.mk
--- a/modules/libmicroros/libmicroros.mk
+++ b/modules/libmicroros/libmicroros.mk
@@ -23,6 +23,14 @@
 CFLAGS_INTERNAL := -D__STDC_WANT_LIB_EXT1__=1 $(CFLAGS_INTERNAL)
 CXXFLAGS_INTERNAL := -Drestrict=__restrict__ $(CXXFLAGS_INTERNAL)
 
+# NCS with BT enabled (SoftDevice Controller, CONFIG_BT_LL_SOFTDEVICE) makes
+# the nrfx reserved-resources header (pulled in via cmsis_core.h) include
+# sdc_soc.h and mpsl.h — but Zephyr's exported CFLAGS don't carry those
+# nrfxlib include paths, so the colcon cross-build fails on them. Add the
+# paths (no-op when BT/SDC is not in the config; micro-ROS doesn't use BT).
+NRFXLIB := $(ZEPHYR_BASE)/../nrfxlib
+CFLAGS_INTERNAL := -I$(NRFXLIB)/softdevice_controller/include -I$(NRFXLIB)/mpsl/include $(CFLAGS_INTERNAL)
+CXXFLAGS_INTERNAL := -I$(NRFXLIB)/softdevice_controller/include -I$(NRFXLIB)/mpsl/include $(CXXFLAGS_INTERNAL)
 
 CFLAGS_INTERNAL := -c -I$(ZEPHYR_BASE)/include/posix -I$(PROJECT_BINARY_DIR)/include/generated $(CFLAGS_INTERNAL)
 CXXFLAGS_INTERNAL := -c -I$(ZEPHYR_BASE)/include/posix -I$(PROJECT_BINARY_DIR)/include/generated $(CXXFLAGS_INTERNAL)
